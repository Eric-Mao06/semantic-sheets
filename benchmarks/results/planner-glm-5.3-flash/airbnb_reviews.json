              "name": "wifi_unreliable",
              "kind": "boolean",
              "instruction": "Does this guest review report problems with unreliable Wi-Fi? The text may be in any language; judge the meaning, not the language. Count it as true if the guest complains about Wi-Fi being slow, dropping, not working, weak, or otherwise unreliable (e.g. 'the wifi kept cutting out', 'internet was terrible, could barely connect', 'el wifi no funcionaba'). Do NOT count praise for good or fast Wi-Fi, listings that merely advertise Wi-Fi, or reviews that never mention internet/Wi-Fi.",
              "criteria": {
                "true": "The review reports an actual problem with the Wi-Fi/internet at the property being unreliable: slow, intermittent, dropping, weak signal, or not working. Implied complaints count (e.g. 'had to use my phone hotspot because the wifi was useless' implies unreliable Wi-Fi).",
                "false": "The review does not report any Wi-Fi reliability problem: no mention of Wi-Fi/internet, Wi-Fi mentioned only positively or neutrally (e.g. 'fast Wi-Fi', 'great amenities including wifi'), or problems with other things entirely."
              },
              "thresholds": {
                "true_min": 0.7,
                "false_max": 0.3
              },
              "options": null,
              "min_confidence": 0.0,
              "levels": null
            }
          ],
          "on_missing": "unknown"
        },
        {
          "id": "wifi_rows",
          "input": "flag_wifi",
          "op": "filter",
          "where": {
            "column": "wifi_unreliable.value"
          },
          "unknown_policy": "separate"
        },
        {
          "id": "with_price",
          "input": "wifi_rows",
          "op": "compute",
          "columns": [
