              "name": "nightly_price_num",
              "expr": {
                "op": "to_number",
                "args": [
                  {
                    "column": "nightly_price"
                  }
                ]
              }
            }
          ]
        },
        {
          "id": "by_listing",
          "input": "with_price",
          "op": "aggregate",
          "group_by": [
