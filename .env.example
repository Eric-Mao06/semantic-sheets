# Providers
TYPESAFE_API_KEY=apikey_...            # Jev (TypeSafe System One); required unless SS_FAKE_JEV=1
OPENAI_API_KEY=sk-...                  # planner (gpt-6-astra); optional: MCP callers can supply typed plans
SS_PLANNER_MODEL=gpt-6-astra
SS_PLANNER_REASONING=high
SS_JEV_MODEL=jev-1.13.0                # pinned on every job

# Workspace
SS_DEV_WORKSPACE_KEY=change-me         # bearer key for the default workspace (printed on first start if unset)
SS_WORKSPACE_BUDGET_USD=25
SS_DATA_DIR=./data                     # uploads, immutable parquet, job checkpoints, exports (server/data by default)
SS_DATABASE_URL=                       # default sqlite:///$SS_DATA_DIR/meta.db; e.g. postgresql+psycopg://user:pw@host/db

# Limits (proposed defaults from the design)
SS_MAX_ROWS_PER_FILE=100000
SS_HARD_MAX_ROWS=300000
SS_MAX_FILE_BYTES=104857600
SS_DEFAULT_SPEND_TARGET=5
SS_JEV_PACK_ROWS=10                    # rows per provider request (benchmarked; 1 = isolated rows)
SS_JEV_MAX_IN_FLIGHT=12
SS_JEV_RPM=1200
SS_JEV_TPS=250000
SS_CHUNK_ROWS=200

# Process layout
SS_INLINE_WORKER=1                     # run the worker inside the API process (dev); use `make worker` in production
SS_PUBLIC_BASE_URL=http://127.0.0.1:8000
SS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SS_MCP_ALLOWED_HOSTS=                  # set to enable DNS-rebinding host checks on /mcp
SS_FAKE_JEV=0                          # 1 = deterministic offline stand-in for tests/demos
