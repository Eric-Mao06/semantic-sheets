# Copy to .env at the repo root and load it before starting the API and the worker:
#   set -a; source .env; set +a
# Every variable is documented in docs/configuration.md.

# --- Jev (per-row semantic judgements) ---------------------------------------------------------
# At least one of these three keys is required. Each key enables one route with its own rate limit; packets are
# spread over every route that has a key.
TYPESAFE_API_KEY=apikey_...
OPENROUTER_API_KEY=sk-or-...
AI_GATEWAY_API_KEY=vck_...
# JEV_ROUTES=direct,openrouter,vercel # "direct" = api.typesafe.ai, "openrouter" = OpenRouter's decisions endpoint,
#                                     # "vercel" = Vercel AI Gateway /v1/evaluate (model typesafe-ai/jev)

# --- Planner (plain language -> typed plan) -----------------------------------------------------
# Option A (default): DeepSeek V4.1 Flash on Together via OpenRouter, 2-5 s per plan (see benchmarks/RESULTS.md).
# Uses OPENROUTER_API_KEY above; nothing else to set. Any other OpenRouter model works too:
# PLANNER_PROVIDER=openrouter
# PLANNER_MODEL=z-ai/glm-5.3-flash
# PLANNER_OPENROUTER_PROVIDERS=Together   # pin the upstream provider(s), no fallbacks; empty = OpenRouter's routing
# PLANNER_REASONING=high

# Option B: OpenAI Responses API (gpt-6-astra, 15-50 s per plan)
# OPENAI_API_KEY=sk-...
# PLANNER_PROVIDER=openai
# PLANNER_MODEL=gpt-6-astra

# --- Workspace ---------------------------------------------------------------------------------
# SEMSHEET_DEMO_TOKEN=demo-token        # bearer token the web app and MCP clients send
# SEMSHEET_WORKSPACE_BUDGET_USD=25      # hard spend ceiling for the demo workspace
# SEMSHEET_DATA_DIR=./data              # SQLite metadata, Parquet snapshots, exports, answer cache
