# Copy to .env at the repo root and load it before starting the API and the worker:
#   set -a; source .env; set +a
# Every variable is documented in docs/configuration.md.

# --- Jev (per-row semantic judgements) ---------------------------------------------------------
# At least one of these two keys is required. With both, packets are spread over both routes.
TYPESAFE_API_KEY=apikey_...
OPENROUTER_API_KEY=sk-or-...
# JEV_ROUTES=direct,openrouter        # "direct" = api.typesafe.ai, "openrouter" = OpenRouter's decisions endpoint

# --- Planner (plain language -> typed plan) -----------------------------------------------------
# Option A: OpenAI Responses API
OPENAI_API_KEY=sk-...
PLANNER_PROVIDER=openai
PLANNER_MODEL=gpt-6-astra
PLANNER_REASONING=high

# Option B: any OpenRouter model (cheaper and faster; see benchmarks/RESULTS.md)
# PLANNER_PROVIDER=openrouter
# PLANNER_MODEL=deepseek/deepseek-v4.1-flash
# PLANNER_OPENROUTER_PROVIDERS=Together   # optional: pin the upstream provider, no fallbacks

# --- Workspace ---------------------------------------------------------------------------------
# SEMSHEET_DEMO_TOKEN=demo-token        # bearer token the web app and MCP clients send
# SEMSHEET_WORKSPACE_BUDGET_USD=25      # hard spend ceiling for the demo workspace
# SEMSHEET_DATA_DIR=./data              # SQLite metadata, Parquet snapshots, exports, answer cache
